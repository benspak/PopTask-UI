# Frontend Environment Configuration

# API Configuration
# In production, set this to your backend API URL
# Leave empty to use relative URLs (recommended for same-domain deployment)
VITE_API_URL=

# App Configuration
VITE_APP_TITLE=Task Dashboard
VITE_APP_DESCRIPTION=A modern task management application

# PWA Configuration
VITE_PWA_NAME=Task Dashboard
VITE_PWA_SHORT_NAME=Tasks
VITE_PWA_THEME_COLOR=#3182CE
VITE_PWA_BACKGROUND_COLOR=#1A202C

# Feature Flags
VITE_ENABLE_OFFLINE=true
VITE_ENABLE_PUSH_NOTIFICATIONS=false

# Analytics (optional)
# VITE_GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID

# Error Reporting (optional)
# VITE_SENTRY_DSN=your-sentry-dsn
