{
  "name": "task-dashboard-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Modern PWA task management application built with React, Chakra UI, and Vite",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headless": "playwright test --headless",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext js,jsx --fix",
    "format": "prettier --write .",
    "analyze": "vite-bundle-analyzer",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist node_modules/.vite",
    "clean:all": "rm -rf dist node_modules/.vite node_modules package-lock.json && npm install",
    "clean:vite": "node clean-vite-cache.js",
    "preview:build": "npm run build && npm run preview",
    "diagnose:emotion": "node fix-emotion-issues.js",
    "test:react": "node test-react-single-instance.js"
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.1.1",
    "@chakra-ui/react": "^2.8.0",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "^10.16.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-quill": "^2.0.0",
    "react-router-dom": "^7.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.1.3",
    "@testing-library/react": "^13.4.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "@vitest/ui": "^0.34.1",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "jsdom": "^22.1.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.2",
    "vite": "^5.4.21",
    "vite-bundle-analyzer": "^0.7.0",
    "vite-plugin-pwa": "^0.16.4",
    "vitest": "^0.34.1",
    "workbox-window": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/task-dashboard-frontend.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/task-dashboard-frontend/issues"
  },
  "homepage": "https://github.com/yourusername/task-dashboard-frontend#readme",
  "keywords": [
    "task-management",
    "react",
    "chakra-ui",
    "vite",
    "file-upload",
    "responsive-design"
  ],
  "author": "Ben Spak",
  "license": "MIT"
}
